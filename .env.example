# Jarvis/.env olarak kopyala, anahtarları yapıştır. Hepsi ücretsiz katman; biri yeter, fazlası kesintisiz çalışma sağlar.
GEMINI_API_KEY=       # https://aistudio.google.com/apikey
GROQ_API_KEY=         # https://console.groq.com/keys
CEREBRAS_API_KEY=     # https://cloud.cerebras.ai
OPENROUTER_API_KEY=   # https://openrouter.ai/keys
GEMINI_API_KEY_2=     # ikinci Google hesabından (kota iki katı)
MISTRAL_API_KEY=      # https://console.mistral.ai/api-keys  (ücretsiz "Experiment" planı)
GITHUB_MODELS_TOKEN=  # https://github.com/settings/tokens  (fine-grained, "Models: read" izni)
SAMBANOVA_API_KEY=    # https://cloud.sambanova.ai/apis
NVIDIA_API_KEY=       # https://build.nvidia.com  (API key)
